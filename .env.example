# Advarr env example — copy to .env (рядом с docker-compose.yml)
# Всё это можно задать и через веб-морду (Settings), env — только первичный сид/секреты.
# ⚠️ Секреты через .env не коммитятся; скриншоты для README обновляет бот screenshots.yml.

# [обязательно] ключ с https://www.themoviedb.org/settings/api (тип v3)
TMDB_API_KEY=

# Jellyseerr / Overseerr: базовый URL + API-ключ (Настройки → Общие → API Key)
SEERR_URL=http://192.168.1.50:5055
SEERR_API_KEY=

# Порт внутри контейнера (публикуется через ports)
# ADVARR_PORT=8787

# Каталог данных (config.json / history.json / runs.json)
# ADVARR_DATA_DIR=/app/data

# За reverse-proxy (nginx/traefik): доверять X-Forwarded-For для rate-limit
# TRUST_PROXY=1

# Защита веб-морды: Basic-Auth (оба поля) ИЛИ API-ключ вместо него
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=change-me-please
# ADVARR_API_KEY=some-long-random-key

TZ=Europe/Moscow
